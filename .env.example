# Required. All LLM calls go through OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Required. Web search: https://app.tavily.com (free plan: 1,000 searches a month)
TAVILY_API_KEY=

# Optional. Any OpenRouter model id that supports tool calling.
CHAT_MODEL=openai/gpt-6-luna
MEMORY_MODEL=openai/gpt-6-luna

# Optional spending cap, useful when the key is shared: refuse all model calls once the app has
# spent this many dollars. OpenRouter only reports the key's lifetime usage, so START is that
# usage when the cap begins (see https://openrouter.ai/settings/keys). Unset means no cap.
# OPENROUTER_KEY_USAGE_CAP_USD=0.02
# OPENROUTER_KEY_USAGE_START_USD=
