# Required. All LLM calls go through OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Required. Web search: https://app.tavily.com (free plan: 1,000 searches a month)
TAVILY_API_KEY=

# Optional. Any OpenRouter model id that supports tool calling.
CHAT_MODEL=openai/gpt-6-luna
MEMORY_MODEL=openai/gpt-6-luna
